# Required, server-only: exact origin for this environment (no path/trailing slash).
APP_ORIGIN=
# Required: Supabase project URL and PUBLIC publishable key. Never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required after provider setup is confirmed: github
AUTH_PROVIDER=
# No privileged key or Meta credential is needed for milestone 1.
